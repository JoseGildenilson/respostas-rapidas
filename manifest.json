{
  "manifest_version": 3,
  "name": "Respostas Rápidas (\\)",
  "version": "1.0.0",
  "description": "Digite \\ no chat de suporte para inserir suas mensagens salvas.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://newhub.interjatotelecom.com.br/chat*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_popup": "popup.html", "default_title": "Respostas Rápidas" },
  "browser_specific_settings": {
    "gecko": {
      "id": "respostas-rapidas@local",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
